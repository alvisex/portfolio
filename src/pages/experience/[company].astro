---
import Layout from '../../layouts/Layout.astro'
import Items from '../../components/Items.vue'
import companies from '../../companies.yml'
import '../../styles/global.css'
import type { Company } from '../../types'

export function getStaticPaths() {
  return companies.map((company: Company) => ({
    params: { company: company.id },
    props: { company },
  }))
}

const { company } = Astro.params
const { role, img, id, items, period, companyName, area, color } = companies[company as keyof typeof companies]
---

<Layout title={`${role} @ ${companyName}`}>
  <main class="min-h-screen grid items-center pt-14" style={`background-color: ${color};`}>
    <div class="container h-full pt-4 md:px-20">
      <a href="/#experience" class="inline-flex items-center">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M9 14 4 9l5-5"></path>
          <path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5v0a5.5 5.5 0 0 1-5.5 5.5H11"></path>
        </svg>

        <span>&nbsp; Home</span>
      </a>

      <div class="md:h-[30svh] my-4 flex flex-wrap md:flex-nowrap">
        <div class="md:w-[60%] w-full flex flex-col items-center justify-center h-full gap-4">
          <h3 class="text-gradient font-bold text-2xl text-center" transition:name={`title-${id}`}>{role}</h3>
          <span>Area: {area}</span>
          <div transition:name={`period-${id}`}>{period}</div>
        </div>
        <div class="w-full my-8">
          <img class="mx-auto h-full object-contain md:max-h-[30svh]" transition:name={`hero-${id}`} src={img} alt="" />
        </div>
      </div>

      <div class="content mb-10">
        <Items items={items} />
      </div>
    </div>
  </main>
</Layout>

<style>
  @reference '../../styles/global.css';
  strong {
    @apply text-amber-700;
  }
  .content > * {
    @apply mb-3;
  }
</style>
